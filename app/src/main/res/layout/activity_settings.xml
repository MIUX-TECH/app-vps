<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan Koneksi VPS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/inputHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host VPS (contoh: 3.27.32.99)" />

        <EditText
            android:id="@+id/inputUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username SSH (contoh: admin)"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/inputSshPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port SSH (default: 22)"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/inputRemotePort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port dashboard di VPS (default: 8080)"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/inputDashboardToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token dashboard (DASHBOARD_TOKEN)"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/inputKeyPassphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Passphrase key (kosongkan jika tidak ada)"
            android:inputType="textPassword"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key .pem: belum dipilih"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnPickKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih File Key .pem"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pengaturan"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catatan: file key .pem disimpan terenkripsi di storage internal app ini saja (Android Keystore), tidak pernah dikirim ke mana pun."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
